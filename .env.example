# =============================================================================
# Brassworth - environment configuration
# =============================================================================
# Copy this to .env and change what you need. Everything prefixed with VITE_ is
# read at BUILD time and is visible to anyone who loads the app, so never put a
# secret in one.
#
# Every variable listed here is actually read by the code. If you find one that
# is not, it is a bug in this file - please report it.
#
# Full reference, with the reasoning behind each: docs/SELF_HOSTING.md
# =============================================================================


# -----------------------------------------------------------------------------
# Browser app
# -----------------------------------------------------------------------------

# Where the app keeps data, and which identity system it uses. This one variable
# switches BOTH, deliberately: pairing browser-side auth with server-side
# storage would mean the client asserting an identity the server never checked.
#
#   localStorage  the default. Simplest, and capped around 5 MB per origin, so a
#                 photo-heavy catalogue will eventually hit the quota.
#   indexeddb     the same local-first mode with far more room. Migrates your
#                 existing localStorage data across on first use.
#   api           talk to the server. This is what the Docker image builds with.
#
# Note the spelling of "indexeddb" - all lowercase. Anything unrecognised falls
# back to localStorage with a warning in the console.
VITE_STORAGE_PROVIDER=localStorage

# Where the API lives, used only when the provider above is "api". Empty means
# same origin, which is how the Docker image serves it.
# VITE_API_BASE_URL=

# Local-mode session length, in hours, with and without "remember me".
VITE_SESSION_EXPIRY_HOURS_REMEMBER=720
VITE_SESSION_EXPIRY_HOURS_SHORT=24


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Only relevant if you are running `npm run start:server` or the container.

# libSQL/SQLite target. A file URL for self-hosting, :memory: for tests, or a
# libsql:// URL for a hosted database.
DATABASE_URL=file:./data/brassworth.db

# Port the API listens on.
PORT=3000

# How long a session lasts before it must be renewed.
SESSION_TTL_HOURS=168

# Set this to "production" in any real deployment. It is what marks the session
# cookie Secure; without it you are handing out non-Secure cookies over HTTPS.
# NODE_ENV=production

# Where the built frontend is served from. Unset means API only.
# STATIC_ROOT=./dist


# -----------------------------------------------------------------------------
# Optional: sign in through an identity provider (OIDC)
# -----------------------------------------------------------------------------
# The first four are required together. Leave them unset for local accounts
# only - the sign-in route reports itself unavailable rather than half-enabling.
# Accounts link on the provider's subject claim, never on email alone, because
# an unverified address would be an account-takeover path.

# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback

# Shown on the sign-in button. Defaults to "your identity provider".
# OIDC_LABEL=Google

# Stable key used when linking accounts. Changing it orphans existing links.
# OIDC_PROVIDER=google


# -----------------------------------------------------------------------------
# Optional: an external gear catalogue source
# -----------------------------------------------------------------------------
# Brassworth ships with a small community catalogue built in. These point it at
# an additional source. Server-side only, because a browser cannot hold an API
# key. Unset means the feature is off and only the bundled catalogue is used.

# GEAR_CATALOGUE_URL=
# How the source is credited in the interface. Defaults to "Vendor catalogue".
# GEAR_CATALOGUE_NAME=
# GEAR_CATALOGUE_API_KEY=
# Header the key is sent in. Defaults to Authorization.
# GEAR_CATALOGUE_API_KEY_HEADER=Authorization
# Template for the header value; {key} is substituted. Defaults to "Bearer {key}".
# GEAR_CATALOGUE_API_KEY_FORMAT=Bearer {key}


# -----------------------------------------------------------------------------
# Reserved: automated price checking
# -----------------------------------------------------------------------------
# NOT YET CONNECTED. The checker is written and tested but no route calls it, so
# setting this currently has no effect. It is documented here so the intent is
# on the record.
#
# When it is wired up it will be off unless set to exactly "true", because it
# makes requests to other people's servers and that should be a deliberate
# choice rather than something that starts because the app was installed. It
# reads only the schema.org product data retailers publish for machines - never
# the rendered page - fetches and obeys robots.txt for every host, refuses when
# robots.txt cannot be read, requires https, and keeps a minimum gap between
# requests to the same host.
# PRICE_WATCH_ENABLED=false
