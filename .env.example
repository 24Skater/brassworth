# =============================================================================
# Home Asset Keeper - Environment Configuration
# =============================================================================
# Copy this file to .env and modify the values as needed.
# All variables prefixed with VITE_ are exposed to the browser.
# =============================================================================

# -----------------------------------------------------------------------------
# Storage Provider Configuration
# -----------------------------------------------------------------------------
# Which storage backend to use for data persistence
# Options:
#   - localStorage: Browser localStorage (default, simple, limited to ~5MB)
#   - indexedDB: Browser IndexedDB (better for larger datasets, up to 50% of disk)
#   - api: Backend API (requires running the backend server - coming soon)
VITE_STORAGE_PROVIDER=localStorage

# -----------------------------------------------------------------------------
# Authentication Configuration
# -----------------------------------------------------------------------------
# Which auth provider to use
# Options:
#   - localStorage: Client-side auth (default, for single-user/demo use)
#   - api: Backend auth (requires running the backend server - coming soon)
VITE_AUTH_PROVIDER=localStorage

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
# Session expiration times (in hours)

# Default session duration (legacy, when rememberMe is not specified)
VITE_SESSION_EXPIRY_HOURS=168

# Session duration when "Remember Me" is checked (default: 30 days = 720 hours)
VITE_SESSION_EXPIRY_HOURS_REMEMBER=720

# Session duration when "Remember Me" is NOT checked (default: 24 hours)
VITE_SESSION_EXPIRY_HOURS_SHORT=24

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Maximum failed login attempts before account lockout
VITE_MAX_LOGIN_ATTEMPTS=5

# Initial lockout duration in minutes (doubles with each subsequent lockout)
VITE_LOCKOUT_DURATION_MINUTES=1

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable features (true/false)

# Enable OCR receipt scanning (requires Tesseract.js, increases bundle size)
VITE_FEATURE_OCR_ENABLED=true

# Enable Excel import/export
VITE_FEATURE_EXCEL_ENABLED=true

# -----------------------------------------------------------------------------
# API Configuration (for when backend is available)
# -----------------------------------------------------------------------------
# Backend API base URL (only used when VITE_STORAGE_PROVIDER=api)
# VITE_API_BASE_URL=http://localhost:3000/api

# API request timeout in milliseconds
# VITE_API_TIMEOUT=30000

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# Development server port (default: 8080)
# VITE_DEV_PORT=8080

# --- Server (Phase 4, optional) ---
# The API is not yet wired to the frontend; these configure `npm run start:server`.

# libSQL/SQLite target. A file URL for self-hosting, :memory: for tests,
# or a libsql:// URL for a hosted database.
DATABASE_URL=file:./data/brassworth.db

# Port the API listens on.
PORT=3000

# How long a session lasts before it must be renewed.
SESSION_TTL_HOURS=168

# Set to "api" to use the server instead of browser storage. This switches BOTH
# storage and authentication — pairing browser-side auth with server-side
# storage would mean the client asserting an identity the server never checked.
# VITE_STORAGE_PROVIDER=api

# Where the API lives. Empty means same origin, which is how the Docker image
# serves it.
# VITE_API_BASE_URL=

# --- Optional: sign in through an identity provider (OIDC) ---
# All four are required together. Leave them unset for local accounts only —
# the sign-in route reports itself unavailable rather than half-enabling.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://app.example.com/api/auth/oidc/callback
# Shown on the sign-in button.
# OIDC_LABEL=Google
# Stable key used when linking accounts. Changing it orphans existing links.
# OIDC_PROVIDER=google

# Where the built frontend is served from. The Docker image sets this.
# STATIC_ROOT=./dist
